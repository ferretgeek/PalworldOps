# Copy to /etc/palworld-ops.env and keep it readable only by root.
PALWORLD_ROOT=/opt/palworld
PALWORLD_SERVICE=palworld.service
PALWORLD_MANAGER=/opt/palworld/bin/palworldctl
PALWORLD_PANEL_STATIC=/opt/palworld/panel
PALWORLD_PANEL_HOST=0.0.0.0
PALWORLD_PANEL_PORT=8213
PALWORLD_PANEL_SESSION_STORE=/opt/palworld/state/panel-sessions.json
PALWORLD_PANEL_PERFORMANCE_DB=/opt/palworld/state/performance-history.sqlite3
PALWORLD_PANEL_PERFORMANCE_INTERVAL=30

# Optional integration with Palworld Breeding Atlas.
PALWORLD_BREED_ROOT=/opt/palworld/breed-helper/public
PALWORLD_BREED_SAVE=/opt/palworld/server/Pal/Saved/SaveGames/0/WORLD_ID/Level.sav
PALWORLD_BREED_REFRESH_SERVICE=palworld-breed-refresh.service
