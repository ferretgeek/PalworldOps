[Unit]
Description=Palworld daily verified backup
After=palworld.service

[Service]
Type=oneshot
User=palworld
Group=palworld
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
ExecStart=/opt/palworld/bin/palworldctl backup create --kind daily --if-changed
