[Unit]
Description=Palworld lightweight LAN control panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=palworld
WorkingDirectory=/opt/palworld/panel
EnvironmentFile=-/etc/palworld-ops.env
Environment=PYTHONUNBUFFERED=1
Environment=PALWORLD_PANEL_HOST=127.0.0.1
Environment=PALWORLD_PANEL_PORT=8213
Environment=PALWORLD_PANEL_SECURE_COOKIE=false
Environment=PALWORLD_MANAGER=/opt/palworld/bin/palworldctl
Environment=PALWORLD_PANEL_STATIC=/opt/palworld/panel
ExecStart=/usr/bin/python3 -I /opt/palworld/bin/palworld-panel
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0007
Nice=10
CPUWeight=10
CPUQuota=50%
IOWeight=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=256M
MemoryMax=1G
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/palworld

[Install]
WantedBy=multi-user.target
